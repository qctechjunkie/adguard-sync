# AdGuard Home Sync Configuration Template
# Copy this file to .env and fill in your actual values

# Logging
LOG_LEVEL=info

# Origin (Primary) AdGuard Home Instance
ORIGIN_URL=http://192.168.1.x:8080
ORIGIN_USERNAME=your_username
ORIGIN_PASSWORD=your_password

# Replica 1 AdGuard Home Instance
REPLICA1_URL=http://192.168.1.x:8080
REPLICA1_USERNAME=your_username
REPLICA1_PASSWORD=your_password

# Optional: Replica 2 AdGuard Home Instance
# REPLICA2_URL=http://192.168.1.x:8080
# REPLICA2_USERNAME=your_username
# REPLICA2_PASSWORD=your_password
# REPLICA2_API_PATH=/some/path/control
# REPLICA2_WEB_URL=https://some-other.url
# REPLICA2_AUTO_SETUP=true
# REPLICA2_INTERFACE_NAME=ens18
# REPLICA2_DHCP_SERVER_ENABLED=true

# Sync Configuration
# Cron format: https://crontab.guru/
# Examples:
#   Every minute: * * * * *
#   Every 2 hours: 0 */2 * * *
#   Every 30 minutes: */30 * * * *
#   Daily at 2 AM: 0 2 * * *
CRON=0 */2 * * *
RUN_ON_START=true

# Optional: Continue on error
# CONTINUE_ON_ERROR=false

# API/Web Interface
# Set to 0 to disable
API_PORT=8080
# API_DARK_MODE=true
# API_USERNAME=admin
# API_PASSWORD=secret
# API_TLS_CERT_DIR=/path/to/certs
# API_TLS_CERT_NAME=tls.crt
# API_TLS_KEY_NAME=tls.key
# API_METRICS_ENABLED=true

# Sync Features (all enabled by default)
FEATURES_GENERAL_SETTINGS=true
FEATURES_QUERY_LOG_CONFIG=true
FEATURES_STATS_CONFIG=true
FEATURES_CLIENT_SETTINGS=true
FEATURES_SERVICES=true
FEATURES_FILTERS=true
FEATURES_DHCP_SERVER_CONFIG=true
FEATURES_DHCP_STATIC_LEASES=true
FEATURES_DNS_SERVER_CONFIG=true
FEATURES_DNS_ACCESS_LISTS=true
FEATURES_DNS_REWRITES=true
FEATURES_THEME=true
